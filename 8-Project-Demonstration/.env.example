# Server only. Never prefix these names with VITE_. Core ML works without Groq.
# Visitors enter their own key in AI Settings; it stays in active-tab memory.
# The server receives that key only with an explicitly requested AI operation.
# Select a model available to visitors' Groq accounts. Retains the Phase 2 model.
GROQ_MODEL=openai/gpt-oss-20b
# Exact origin, without trailing slash. Production requires your HTTPS site origin.
APP_ORIGIN=http://127.0.0.1:5173
# Optional private owner-key fallback is disabled by default. Personal keys take priority.
ALLOW_OWNER_AI=false
# Unused unless ALLOW_OWNER_AI=true AND a valid review access token is supplied.
GROQ_API_KEY=
# Required for EVERY owner-key request, including local requests: >=16 random characters.
# Send privately in X-AI-Access-Token. There is no public owner-code input.
# Visitors supplying X-Groq-API-Key do not need this token.
AI_ACCESS_TOKEN=
